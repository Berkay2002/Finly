# Copy to .env.local. Every value is optional; Finly runs fully without them.

# Sync and reminders. Written for you by `npx convex dev`.
VITE_CONVEX_URL=
# Push reminders: public half of the VAPID pair (the private half lives in Convex env).
VITE_VAPID_PUBLIC_KEY=

# Company logos for subscriptions (https://www.logo.dev). Safe in client code.
VITE_LOGO_DEV_PUBLISHABLE_KEY=
# Exact company picker via /api/logo-search. Server only (Vercel env).
LOGO_DEV_SECRET_KEY=
